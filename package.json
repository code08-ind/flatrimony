{
  "name": "flatrimony",
  "private": true,
  "description": "Flatrimony — verified flatmate matching for Delhi NCR (Rishta pakka, rent split.)",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "prepare": "husky",
    "dev:secrets": "node scripts/dev-secrets.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.0",
    "@flatrimony/config": "workspace:*",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css,sql}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
