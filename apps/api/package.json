{
  "name": "@flatrimony/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Flatrimony REST API (Fastify on Cloud Run)",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage --exclude \"test/integration/**\" --exclude \"test/e2e/**\"",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@flatrimony/db-types": "workspace:*",
    "@flatrimony/routing": "workspace:*",
    "@flatrimony/shared": "workspace:*",
    "@supabase/storage-js": "2.119.0",
    "aws4fetch": "1.0.20",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.15",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@flatrimony/config": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
