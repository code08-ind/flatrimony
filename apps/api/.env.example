# Copy to .env.local for local development. Never commit real values (docs/03 §5).
NODE_ENV=development
APP_ENV=local
PORT=8080
LOG_LEVEL=info
# Supabase local: printed by `pnpm db:start`
DATABASE_URL=
DATABASE_URL_DIRECT=
SUPABASE_URL=
# Access-token verification: issuer is <SUPABASE_URL>/auth/v1. Prefer JWKS (asymmetric keys);
# the legacy HS256 secret is a fallback and must never reach clients.
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Auth Send SMS hook (Standard Webhooks secret `v1,whsec_<base64>`); `pnpm dev:secrets`
# generates a matching local value in supabase/.env and apps/api/.env.local.
SEND_SMS_HOOK_SECRETS=
# Pepper for HMAC lookup hashes of phone numbers, device ids and DigiLocker ids (≥ 32 chars).
# Never change it on a live system: bans and uniqueness depend on it. `pnpm dev:secrets` sets one locally.
HASH_PEPPER=
# OTP SMS provider: only `mock` until the DLT-registered provider exists (T0.6); refused in production.
SMS_PROVIDER=mock
# Proxies whose X-Forwarded-For entry is trusted: 0 locally (default), 1 on Cloud Run.
TRUST_PROXY_HOPS=0
# Place search for the office/college picker: mock (seeded NCR areas) or google (needs the key).
PLACES_PROVIDER=mock
# GOOGLE_PLACES_API_KEY=
# Routing service for commute zones (apps/routing); without it zones are approximate.
# ROUTING_URL=http://localhost:8002
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Added by later milestones (all secrets live in Secret Manager outside local):
# AES-256-GCM key for verified names (T3.1): v1:<base64 of 32 bytes>. Required outside local.
# FIELD_ENCRYPTION_KEY=
# R2_ACCOUNT_ID= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY= R2_BUCKET=
# DigiLocker verification (T3.1). Only the mock exists until the provider is chosen (T0.7).
DIGILOCKER_PROVIDER=mock
# Standard Webhooks secret(s) the provider signs its webhooks with: v1,whsec_<base64>. Required
# outside local (pnpm dev:secrets writes a local one).
# DIGILOCKER_WEBHOOK_SECRETS=
# The API's public URL for links it hands out (the mock consent page). Required outside local.
# PUBLIC_API_URL=http://localhost:8080
# Serve the mock consent page outside local (test data only: anyone can verify as anyone).
# DIGILOCKER_MOCK_CONSENT_PAGE=false
# Real provider credentials (later): DIGILOCKER_PROVIDER_CLIENT_ID= DIGILOCKER_PROVIDER_SECRET=
# EXPO_ACCESS_TOKEN=
# Work/college email links (T3.3). Only the mock exists until an email vendor is chosen.
EMAIL_PROVIDER=mock
# The web app's origin: email links open its /{locale}/verify-email page. Required outside local.
# WEB_APP_URL=http://localhost:3000
# EMAIL_API_KEY=
# ROUTING_URL=
# SENTRY_DSN=
# POSTHOG_KEY=
