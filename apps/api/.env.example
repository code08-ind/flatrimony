# Copy to .env.local for local development. Never commit real values (docs/03 §5).
NODE_ENV=development
APP_ENV=local
PORT=8080
LOG_LEVEL=info
# Supabase local: printed by `pnpm db:start`
DATABASE_URL=
DATABASE_URL_DIRECT=
SUPABASE_URL=
# Access-token verification: issuer is <SUPABASE_URL>/auth/v1. Prefer JWKS (asymmetric keys);
# the legacy HS256 secret is a fallback and must never reach clients.
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Auth Send SMS hook (Standard Webhooks secret `v1,whsec_<base64>`); `pnpm dev:secrets`
# generates a matching local value in supabase/.env and apps/api/.env.local.
SEND_SMS_HOOK_SECRETS=
# Pepper for HMAC lookup hashes of phone numbers, device ids and DigiLocker ids (≥ 32 chars).
# Never change it on a live system: bans and uniqueness depend on it. `pnpm dev:secrets` sets one locally.
HASH_PEPPER=
# OTP SMS provider: only `mock` until the DLT-registered provider exists (T0.6); refused in production.
SMS_PROVIDER=mock
# Proxies whose X-Forwarded-For entry is trusted: 0 locally (default), 1 on Cloud Run.
TRUST_PROXY_HOPS=0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Added by later milestones (all secrets live in Secret Manager outside local):
# FIELD_ENCRYPTION_KEY=
# R2_ACCOUNT_ID= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY= R2_BUCKET=
# DIGILOCKER_PROVIDER_CLIENT_ID= DIGILOCKER_PROVIDER_SECRET= DIGILOCKER_WEBHOOK_SECRET=
# EXPO_ACCESS_TOKEN=
# EMAIL_API_KEY=
# ROUTING_URL=
# SENTRY_DSN=
# POSTHOG_KEY=
