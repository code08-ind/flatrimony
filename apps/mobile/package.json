{
  "name": "@flatrimony/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Flatrimony Android app (Expo + Expo Router; iOS in v1.2)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "export:android": "expo export --platform android --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@flatrimony/design-tokens": "workspace:*",
    "@flatrimony/i18n": "workspace:*",
    "@flatrimony/shared": "workspace:*",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "i18next": "^27.0.1",
    "react": "19.3.0",
    "react-i18next": "^18.0.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@flatrimony/config": "workspace:*",
    "@types/react": "^19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
