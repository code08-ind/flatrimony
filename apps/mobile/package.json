{
  "name": "@flatrimony/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Flatrimony Android app (Expo + Expo Router; iOS in v1.2)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "export:android": "expo export --platform android --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist-web",
    "test:e2e:web": "playwright test"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@flatrimony/client": "workspace:*",
    "@flatrimony/design-tokens": "workspace:*",
    "@flatrimony/i18n": "workspace:*",
    "@flatrimony/shared": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "i18next": "^27.0.1",
    "phosphor-react-native": "^3.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@flatrimony/config": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "pg": "^8.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
