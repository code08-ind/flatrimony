{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "APP_ENV": "local" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "preview",
      "env": { "APP_ENV": "staging" }
    },
    "staging": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "staging",
      "env": { "APP_ENV": "staging" }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "channel": "production",
      "autoIncrement": true,
      "env": { "APP_ENV": "production" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal" }
    }
  }
}
