{
  "name": "@flatrimony/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Flatrimony design tokens (docs/06 §3) → TS, CSS variables, Tailwind/NativeWind preset, RN theme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/css/tokens.css",
    "./tokens.json": "./tokens.json"
  },
  "files": [
    "dist",
    "tokens.json"
  ],
  "scripts": {
    "generate": "tsx scripts/generate.ts data && prettier --write src/tokens.data.ts",
    "build": "tsc -p tsconfig.build.json && tsx scripts/generate.ts css",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@flatrimony/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
